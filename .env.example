# Copy to .env (optional - project runs without it)
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=*
# Default is SQLite. For PostgreSQL use:
# DATABASE_URL=postgres://user:pass@localhost:5432/serviceconnect
# Redis (for multi-instance chat). Leave empty for in-memory.
# REDIS_URL=redis://localhost:6379/0
# Razorpay (leave empty = MOCK payment mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COMMISSION_PERCENT=10
